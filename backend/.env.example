# OpenAI Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4-turbo-preview

# Qdrant Cloud Configuration
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION_NAME=textbook-chapters

# Neon Serverless Postgres Configuration
NEON_CONNECTION_STRING=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/dbname?sslmode=require

# Better-Auth Configuration
BETTER_AUTH_SECRET=your-secret-key-minimum-32-characters-long
BETTER_AUTH_ISSUER=better-auth

# Redis Configuration (for rate limiting)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting Settings
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Timeout Settings (seconds)
VECTOR_DB_TIMEOUT=5
LLM_TIMEOUT=25
TOTAL_TIMEOUT=30

# Application Settings
ENV=development
LOG_LEVEL=DEBUG
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
